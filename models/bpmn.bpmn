<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Receiving" targetNamespace="https://github.com/alex020160/warehouse-responsible-storage" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:message id="Message_Plan" name="Сведения об ожидаемой поставке" />
  <bpmn:message id="Message_Clarify" name="Уточнения и документы" />
  <bpmn:message id="Message_Agreement" name="Решение клиента" />
  <bpmn:collaboration id="Collaboration_Receiving">
    <bpmn:participant id="P_CLIENT" name="Клиент-грузовладелец" />
    <bpmn:participant id="P_ORG" name="Организация ответственного хранения" processRef="Process_Receiving" />
    <bpmn:messageFlow id="MessageFlow_1" name="Сведения об ожидаемой поставке" sourceRef="P_CLIENT" targetRef="S0" />
    <bpmn:messageFlow id="MessageFlow_2" name="Запрос уточнения" sourceRef="T03" targetRef="P_CLIENT" />
    <bpmn:messageFlow id="MessageFlow_3" name="Уточнения и недостающие документы" sourceRef="P_CLIENT" targetRef="E2" />
    <bpmn:messageFlow id="MessageFlow_4" name="Результат приёмки для согласования" sourceRef="T10" targetRef="P_CLIENT" />
    <bpmn:messageFlow id="MessageFlow_5" name="Подтверждённое принимаемое количество" sourceRef="P_CLIENT" targetRef="T10" />
    <bpmn:messageFlow id="MessageFlow_6" name="Дополнительное решение по критическим расхождениям" sourceRef="P_CLIENT" targetRef="E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Receiving" name="Приёмка товара на ответственное хранение" isExecutable="false">
    <bpmn:documentation>Начало: получение информации о планируемой поставке. Конец: товар принят, зарегистрирован и размещён в складской ячейке. Модель аналитического этапа, не исполняемый процесс.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Receiving">
      <bpmn:lane id="L_IS" name="Информационная система">
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_STORE" name="Кладовщик">
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ACCEPT" name="Сотрудник приёмки">
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
