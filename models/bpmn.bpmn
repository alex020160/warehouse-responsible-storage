    <bpmn:intermediateCatchEvent id="E1" name="Товар прибыл на склад">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="E1_definition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Прибытие подтверждено сотрудником</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
